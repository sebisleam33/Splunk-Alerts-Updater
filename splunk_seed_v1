# Strip Windows line endings (CRLF) in case this Dockerfile was saved/copied on Windows
USER root
RUN find /opt/splunk-etc/apps/poc_seed -type f -exec sed -i 's/\r$//' {} + \
 && chown -R splunk:splunk /opt/splunk-etc/apps/poc_seed

# Validate embedded files without starting Splunk or leaving test events in the image.
RUN python3 <<'PY'
import configparser
import os
from pathlib import Path
import shlex
import subprocess
import sys
import tempfile
from collections import Counter

app = Path("/opt/splunk-etc/apps/poc_seed")
config = configparser.ConfigParser(interpolation=None)
config.read(app / "default" / "savedsearches.conf")
alerts = [config[name] for name in config.sections() if config[name].get("alert.track") == "1"]
assert len(config.sections()) == 11 and len(alerts) == 10, "Expected 10 alerts and one report"
for alert in alerts:
    assert alert["is_scheduled"] == "1" and alert["disabled"] == "0"
    assert alert["alert_type"] == "number of events"
    assert alert["alert_comparator"] == "greater than" and alert["alert_threshold"] == "0"
    assert len(alert["cron_schedule"].split()) == 5

with tempfile.TemporaryDirectory() as home:
    env = dict(os.environ, SPLUNK_HOME=home)
    command = [sys.executable, str(app / "bin" / "seed_logs.py")]
    subprocess.run(command, env=env, check=True)
    seed = Path(home) / "var" / "poc_seed" / "sample.log"
    before = seed.read_bytes()
    lines = before.decode("utf-8").splitlines()
    assert len(lines) == 200, "Expected exactly 200 seed logs"
    events = [dict(field.split("=", 1) for field in shlex.split(line)[1:]) for line in lines]
    errors = [e for e in events if e["level"] == "ERROR"]
    logins = [e for e in events if e["msg"] == "login failed"]
    assert len(errors) > 5
    assert logins
    assert any(e["service"] == "payments" for e in errors)
    assert any(e["msg"] == "slow query" and int(e["duration_ms"]) > 1000 for e in events)
    assert any(e["msg"] == "db connection refused" for e in events)
    assert any(e["msg"] == "timeout calling bank" for e in events)
    assert max(Counter(e["service"] for e in errors).values()) > 3
    assert max(Counter(e["service"] for e in events if e["msg"] == "high memory usage").values()) >= 2
    assert any(e["status"] == "500" for e in events)
    assert max(Counter(e["user"] for e in logins).values()) >= 3
    subprocess.run(command, env=env, check=True)
    assert seed.read_bytes() == before, "Restart must not rewrite seed logs"
print("Validated 200 seed logs, 10 alert conditions, and restart-safe generation")
PY
USER ansible
