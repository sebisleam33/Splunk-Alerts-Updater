# syntax=docker/dockerfile:1
#
# Self-contained Splunk POC image: index, HEC token, 200 seed logs and scheduled jobs/alerts.
# Everything is defined inline in this file - no other files needed.
#
# Base: public Splunk Enterprise image, downloaded automatically during build.
# Splunk licensing still applies; the Enterprise trial supports scheduled alerts.
# Requires Docker with Linux containers and BuildKit. No PowerShell or host files are used.
#
# Run from the folder containing this Dockerfile - build FIRST, then run:
#
#   docker build -t poc-splunk .
#   docker run -d --name poc-splunk -p 8000:8000 -p 8088:8088 -p 8089:8089 poc-splunk
#
# "pull access denied for poc-splunk" = the build step was skipped or failed (poc-splunk is a local
# image, it does not exist on Docker Hub). Check with: docker images poc-splunk
#
#   Web: http://localhost:8000  (admin / Changeme123!)   Search: index=poc
#   Override password at runtime: docker run -e SPLUNK_PASSWORD='MyPass123!' ...
#
# How it works:
#   - The official image keeps its default config in /opt/splunk-etc and copies it into the
#     /opt/splunk/etc volume on first start, so the app is placed there.
#   - Seed logs are generated by a scripted input when splunkd first starts (fresh timestamps,
#     covering all ten alert conditions). The file is written once per data volume and
#     indexed by a monitor input. Preserve /opt/splunk/etc and /opt/splunk/var together.
#   - Demo credentials below are for local testing only; override the password at runtime.
#   - Use fresh volumes for the initial setup; existing Splunk configs can override this app.

FROM splunk/splunk:latest

ENV SPLUNK_START_ARGS=--accept-license \
    SPLUNK_GENERAL_TERMS=--accept-sgt-current-at-splunk-com \
    SPLUNK_PASSWORD=Changeme123!

EXPOSE 8000 8088 8089

# ---------------------------------------------------------------------------------------------
# App: poc_seed
# ---------------------------------------------------------------------------------------------

COPY --chown=splunk:splunk <<'EOF' /opt/splunk-etc/apps/poc_seed/default/app.conf
[install]
state = enabled

[ui]
is_visible = true
label = POC Seed

[launcher]
version = 1.0.0
description = Preseeds index, HEC token, sample logs and alerts
EOF

COPY --chown=splunk:splunk <<'EOF' /opt/splunk-etc/apps/poc_seed/metadata/local.meta
[]
access = read : [ * ], write : [ admin ]
export = system

[savedsearches]
owner = admin
EOF

COPY --chown=splunk:splunk <<'EOF' /opt/splunk-etc/apps/poc_seed/default/indexes.conf
[poc]
homePath   = $SPLUNK_DB/poc/db
coldPath   = $SPLUNK_DB/poc/colddb
thawedPath = $SPLUNK_DB/poc/thaweddb
frozenTimePeriodInSecs = 2592000
EOF

COPY --chown=splunk:splunk <<'EOF' /opt/splunk-etc/apps/poc_seed/default/inputs.conf
[http]
disabled = 0

[http://poc_hec]
disabled = 0
token = 11111111-2222-3333-4444-555555555555
index = poc
indexes = poc
sourcetype = _json

# Runs once when splunkd starts; writes the seed file only if it does not exist yet
[script://./bin/seed_logs.py]
disabled = 0
interval = -1
python.version = python3
index = _internal
sourcetype = poc:seed:status

[monitor:///opt/splunk/var/poc_seed/*.log]
disabled = 0
index = poc
sourcetype = poc:app
EOF

COPY --chown=splunk:splunk <<'EOF' /opt/splunk-etc/apps/poc_seed/default/props.conf
[poc:app]
TIME_PREFIX = ^
TIME_FORMAT = %Y-%m-%dT%H:%M:%SZ
TZ = UTC
MAX_TIMESTAMP_LOOKAHEAD = 25
SHOULD_LINEMERGE = false
LINE_BREAKER = ([\r\n]+)
KV_MODE = auto
EOF

# Seed log generator - change LOG_COUNT to generate more/less events
COPY --chown=splunk:splunk --chmod=755 <<'EOF' /opt/splunk-etc/apps/poc_seed/bin/seed_logs.py
#!/usr/bin/env python3
import datetime
import os

LOG_COUNT = 200
SPREAD_SECONDS = 300

# Repeated scenarios guarantee coverage instead of relying on random alert matches.
SCENARIOS = [
    ("ERROR", "auth", "alice", "login failed", 120, 401),
    ("ERROR", "payments", "bob", "timeout calling bank", 2800, 500),
    ("ERROR", "db", "carol", "db connection refused", 1500, 500),
    ("ERROR", "api", "dave", "internal server error", 900, 500),
    ("WARN", "db", "erin", "slow query", 1800, 200),
    ("WARN", "web", "frank", "high memory usage", 600, 200),
    ("WARN", "api", "alice", "retrying request", 450, 200),
    ("INFO", "auth", "bob", "login ok", 50, 200),
    ("INFO", "payments", "carol", "payment processed", 150, 200),
    ("INFO", "web", "dave", "cache hit", 10, 200),
]

home = os.environ.get("SPLUNK_HOME", "/opt/splunk")
out_dir = os.path.join(home, "var", "poc_seed")
out_file = os.path.join(out_dir, "sample.log")

if os.path.exists(out_file):
    print("poc_seed: %s already exists, skipping" % out_file)
    raise SystemExit(0)

os.makedirs(out_dir, exist_ok=True)
now = datetime.datetime.now(datetime.timezone.utc)
events = []
for i in range(LOG_COUNT):
    level, service, user, message, duration, status = SCENARIOS[i % len(SCENARIOS)]
    ts = now - datetime.timedelta(seconds=i * SPREAD_SECONDS // LOG_COUNT)
    events.append((ts, '{} level={} service={} user={} msg="{}" duration_ms={} status={}'.format(
        ts.strftime("%Y-%m-%dT%H:%M:%SZ"), level, service, user, message, duration, status)))
events.sort(key=lambda e: e[0])

tmp = out_file + ".tmp"
with open(tmp, "w", encoding="utf-8", newline="\n") as f:
    f.write("\n".join(line for _, line in events) + "\n")
os.rename(tmp, out_file)  # atomic, so the monitor never reads a partial file
print("poc_seed: wrote %d events to %s" % (LOG_COUNT, out_file))
EOF

# Scheduled jobs / alerts (Activity > Triggered Alerts, Settings > Searches, reports, and alerts)
# 10 alerts + 1 daily report. Fresh seed data meets all conditions within the 60m window.
# Alerts run every 5-15 minutes; they stop matching after the seed data ages out.
# Threshold logic is done in SPL ("| where ...") so "number of events > 0" means "condition met".
COPY --chown=splunk:splunk <<'EOF' /opt/splunk-etc/apps/poc_seed/default/savedsearches.conf
# Alert 1
[POC - Too many errors]
search = index=poc level=ERROR | stats count | where count > 5
dispatch.earliest_time = -60m
dispatch.latest_time = now
is_scheduled = 1
cron_schedule = */5 * * * *
alert_type = number of events
alert_comparator = greater than
alert_threshold = 0
alert.track = 1
alert.severity = 4
alert.digest_mode = 1
alert.suppress = 0
disabled = 0

# Alert 2
[POC - Failed logins]
search = index=poc msg="login failed" | stats count by user
dispatch.earliest_time = -60m
