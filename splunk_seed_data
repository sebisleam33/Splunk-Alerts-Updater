# Seed log generator - change LOG_COUNT to generate more/less events
COPY --chown=splunk:splunk --chmod=755 <<'EOF' /opt/splunk-etc/apps/poc_seed/bin/seed_logs.py
#!/usr/bin/env python3
import datetime
import os

LOG_COUNT = 200
SPREAD_SECONDS = 300

# Repeated scenarios guarantee coverage instead of relying on random alert matches.
SCENARIOS = [
    ("ERROR", "auth", "alice", "login failed", 120, 401),
    ("ERROR", "payments", "bob", "timeout calling bank", 2800, 500),
    ("ERROR", "db", "carol", "db connection refused", 1500, 500),
    ("ERROR", "api", "dave", "internal server error", 900, 500),
    ("WARN", "db", "erin", "slow query", 1800, 200),
    ("WARN", "web", "frank", "high memory usage", 600, 200),
    ("WARN", "api", "alice", "retrying request", 450, 200),
    ("INFO", "auth", "bob", "login ok", 50, 200),
    ("INFO", "payments", "carol", "payment processed", 150, 200),
    ("INFO", "web", "dave", "cache hit", 10, 200),
]

home = os.environ.get("SPLUNK_HOME", "/opt/splunk")
out_dir = os.path.join(home, "var", "poc_seed")
out_file = os.path.join(out_dir, "sample.log")

if os.path.exists(out_file):
    print("poc_seed: %s already exists, skipping" % out_file)
    raise SystemExit(0)

os.makedirs(out_dir, exist_ok=True)
now = datetime.datetime.now(datetime.timezone.utc)
events = []
for i in range(LOG_COUNT):
    level, service, user, message, duration, status = SCENARIOS[i % len(SCENARIOS)]
    ts = now - datetime.timedelta(seconds=i * SPREAD_SECONDS // LOG_COUNT)
    events.append((ts, '{} level={} service={} user={} msg="{}" duration_ms={} status={}'.format(
        ts.strftime("%Y-%m-%dT%H:%M:%SZ"), level, service, user, message, duration, status)))
events.sort(key=lambda e: e[0])

tmp = out_file + ".tmp"
with open(tmp, "w", encoding="utf-8", newline="\n") as f:
    f.write("\n".join(line for _, line in events) + "\n")
os.rename(tmp, out_file)  # atomic, so the monitor never reads a partial file
print("poc_seed: wrote %d events to %s" % (LOG_COUNT, out_file))
EOF

# Additional small, deterministic datasets across payments, security and platform indexes.
COPY --chown=splunk:splunk --chmod=755 <<'EOF' /opt/splunk-etc/apps/poc_seed/bin/seed_scenario_logs.py
#!/usr/bin/env python3
import datetime
import os
from pathlib import Path

HOME = os.environ.get("SPLUNK_HOME", "/opt/splunk")
BASE = Path(HOME) / "var" / "poc_seed" / "scenarios"
COUNT = 90
DATA = {
    "payments": [
        ("INFO", "payment-api", "approved", 200, 120),
        ("WARN", "payment-api", "retry", 202, 1800),
        ("ERROR", "payment-api", "bank timeout", 504, 5000),
        ("ERROR", "payout-worker", "payout rejected", 422, 900),
        ("INFO", "payout-worker", "payout completed", 200, 750),
        ("ERROR", "ledger", "duplicate transaction", 409, 300),
    ],
    "security": [
        ("INFO", "auth-service", "login success", 200, 40),
        ("WARN", "auth-service", "invalid password", 401, 60),
        ("ERROR", "auth-service", "account locked", 423, 55),
        ("WARN", "fraud-service", "risk threshold exceeded", 202, 150),
        ("ERROR", "fraud-service", "blocked transaction", 403, 240),
    ],
    "platform": [
        ("INFO", "gateway", "health check passed", 200, 15),
        ("WARN", "gateway", "upstream latency", 200, 2200),
        ("ERROR", "database", "connection refused", 503, 1300),
        ("ERROR", "queue-worker", "message retry exhausted", 500, 800),
        ("WARN", "cache", "memory threshold exceeded", 200, 500),
    ],
}

now = datetime.datetime.now(datetime.timezone.utc)
for group, rows in DATA.items():
    out_dir = BASE / group
    out_file = out_dir / "events.log"
    if out_file.exists():
        print(f"scenario seed: {out_file} already exists; skipping")
        continue
    out_dir.mkdir(parents=True, exist_ok=True)
    lines = []
    for i in range(COUNT):
        level, service, message, status, duration = rows[i % len(rows)]
        ts = now - datetime.timedelta(seconds=(COUNT - i))
        lines.append(
            f'{ts:%Y-%m-%dT%H:%M:%SZ} level={level} service={service} '
            f'event="{message}" user=user{i % 7} status={status} duration_ms={duration} '
            f'transaction_id=tx-{group}-{i:04d}'
        )
    tmp = out_file.with_suffix(".tmp")
    tmp.write_text("\n".join(lines) + "\n", encoding="utf-8")
    tmp.replace(out_file)
    print(f"scenario seed: wrote {len(lines)} events to {out_file}")
EOF

# Creates the demo accounts and alert fixtures from runtime environment variables.
COPY --chown=splunk:splunk --chmod=755 <<'EOF' /opt/splunk-etc/apps/poc_seed/bin/seed_users_alerts.py
#!/usr/bin/env python3
import base64
import os
import ssl
import time
from urllib.error import HTTPError, URLError
from urllib.parse import quote, urlencode
from urllib.request import Request, urlopen

BASE = "https://localhost:8089"
ADMIN = "admin"
ADMIN_PASSWORD = os.environ.get("SPLUNK_PASSWORD", "")
TLS = ssl._create_unverified_context()  # only for the local self-signed Splunk certificate


def call(method, path, data=None, username=None, password=None):
    username = username or ADMIN
    password = password or ADMIN_PASSWORD
    if not password:
        raise RuntimeError("SPLUNK_PASSWORD is missing from the container environment")
    body = urlencode(data or {}, doseq=True).encode() if data is not None else None
    token = base64.b64encode(f"{username}:{password}".encode()).decode()
    req = Request(BASE + path, data=body, method=method, headers={
        "Authorization": "Basic " + token,
        "Content-Type": "application/x-www-form-urlencoded",
        "Accept": "application/json",
    })
    try:
        with urlopen(req, context=TLS, timeout=20) as response:
            return response.status
    except HTTPError as exc:
        detail = exc.read().decode("utf-8", "replace")[:800]
        raise RuntimeError(f"{method} {path}: HTTP {exc.code}: {detail}") from exc


def exists(path):
    try:
        call("GET", path + "?output_mode=json")
        return True
    except RuntimeError as exc:
        if "HTTP 404" in str(exc):
            return False
        raise


def create_user(name, password, role):
    path = "/services/authentication/users/" + quote(name, safe="")
    if exists(path):
        print(f"seed_users_alerts: {name} already exists; leaving it unchanged")
        return
    call("POST", "/services/authentication/users", {
        "name": name, "password": password, "roles": role,
        "realname": name.title() + " Test User",
    })
    print(f"seed_users_alerts: created {name}")


def saved_search(owner, password, app, name, search, actions, sharing):
    owner_q, app_q, name_q = quote(owner, safe=""), quote(app, safe=""), quote(name, safe="")
    path = f"/servicesNS/{owner_q}/{app_q}/saved/searches/{name_q}"
    fields = {
        "name": name,
        "search": search,
        "is_scheduled": "1",
        "disabled": "1",
        "cron_schedule": "*/15 * * * *",
        "dispatch.earliest_time": "-60m",
        "dispatch.latest_time": "now",
        "alert.track": "1",
        "alert_type": "number of events",
        "alert_comparator": "greater than",
        "alert_threshold": "0",
    }
    fields.update(actions)
    # Create or update the search in the owner's namespace. This also upgrades
    # fixtures created by earlier versions from disabled to scheduled alerts.
    if exists(path):
        call("POST", path, fields, username=owner, password=password)
    else:
        call("POST", f"/servicesNS/{owner_q}/{app_q}/saved/searches", fields,
             username=owner, password=password)
    # Admin sets sharing and explicit ACLs. Sharing controls visibility; the
    # owner role is the only non-admin role allowed to write this object.
    role = "splunkbulk_" + owner
    call("POST", path + "/acl", {
        "owner": owner,
        "sharing": sharing,
        "perms.read": "*" if sharing == "global" else role,
        "perms.write": role,
    })
    print(f"seed_users_alerts: ensured {sharing} search {app}/{name} (owner={owner})")


def main():
    alice_password = os.environ.get("ALICE_PASSWORD", "")
    bob_password = os.environ.get("BOB_PASSWORD", "")
    if not alice_password or not bob_password:
        raise RuntimeError("Set ALICE_PASSWORD and BOB_PASSWORD with docker run -e")
    for name, password in (("ALICE_PASSWORD", alice_password), ("BOB_PASSWORD", bob_password)):
        if len(password) < 8 or any(ord(char) < 32 or ord(char) > 126 for char in password):
            raise RuntimeError(f"{name} must contain at least 8 printable ASCII characters")

    # Wait until the management REST API is ready before creating/updating fixtures.
    for attempt in range(90):
        try:
            call("GET", "/services/server/info?output_mode=json")
            break
        except (RuntimeError, URLError):
            if attempt == 89:
                raise
            time.sleep(5)

    create_user("alice", alice_password, "splunkbulk_alice")
    create_user("bob", bob_password, "splunkbulk_bob")

    cases = [
        ("alice", alice_password, "bulk_test_alice", "ALICE - Private - Webhook", "index=poc level=ERROR service=payments", {"action.webhook": "1", "action.webhook.param.url": "https://example.invalid/alice/private", "action.email": "0"}, "user"),
        ("alice", alice_password, "bulk_test_alice", "ALICE - Private - Email", "index=poc level=WARN service=api", {"action.email": "1", "action.email.to": "alice@example.invalid", "action.email.from": "splunk-test@example.invalid", "action.email.subject": "Alice private test", "action.email.maxresults": "25", "action.email.include.results_link": "1", "action.email.include.search": "1", "action.email.include.trigger": "1", "action.email.include.trigger_time": "1", "action.email.include.view_link": "1", "action.email.inline": "1", "action.email.sendcsv": "1", "action.email.allow_empty_attachment": "1", "action.email.sendresults": "1", "action.webhook": "0"}, "user"),
        ("alice", alice_password, "bulk_test_alice", "ALICE - Global - Webhook + Email", "index=poc level=ERROR", {"action.webhook": "1", "action.webhook.param.url": "https://example.invalid/alice/global", "action.webhook.param.post_key": "alice-global-demo", "action.email": "1", "action.email.to": "alice@example.invalid", "action.email.subject": "Alice webhook and email test", "action.email.include.results_link": "1", "action.email.sendcsv": "1"}, "global"),
        ("alice", alice_password, "bulk_test_alice", "ALICE - Global - Webhook Settings B", "index=poc status=500", {"action.webhook": "1", "action.webhook.param.url": "https://example.invalid/alice/second", "action.webhook.param.post_key": "alice-demo", "action.email": "0"}, "global"),
        ("bob", bob_password, "bulk_test_bob", "BOB - Private - Email", "index=poc level=ERROR service=db", {"action.email": "1", "action.email.to": "bob@example.invalid", "action.email.from": "splunk-test@example.invalid", "action.email.subject": "Bob private test", "action.email.maxresults": "10", "action.email.include.results_link": "0", "action.email.include.search": "0", "action.email.include.trigger": "1", "action.email.include.trigger_time": "0", "action.email.include.view_link": "0", "action.email.inline": "0", "action.email.sendcsv": "0", "action.email.sendresults": "1", "action.webhook": "0"}, "user"),
        ("bob", bob_password, "bulk_test_bob", "BOB - Private - Webhook", "index=poc level=WARN", {"action.webhook": "1", "action.webhook.param.url": "https://example.invalid/bob/private", "action.email": "0"}, "user"),
        ("bob", bob_password, "bulk_test_bob", "BOB - Global - Webhook + Email", "index=poc service=payments", {"action.webhook": "1", "action.webhook.param.url": "https://example.invalid/bob/global", "action.webhook.param.post_key": "bob-global-demo", "action.email": "1", "action.email.to": "bob@example.invalid", "action.email.subject": "Bob webhook and email test", "action.email.include.results_link": "1", "action.email.sendresults": "1"}, "global"),
        ("bob", bob_password, "bulk_test_bob", "BOB - Global - Webhook Settings B", "index=poc status=401", {"action.webhook": "1", "action.webhook.param.url": "https://example.invalid/bob/second", "action.webhook.param.post_key": "bob-demo", "action.email": "0"}, "global"),
        # Empty-action and incomplete-action cases.
        ("alice", alice_password, "bulk_test_alice", "ALICE - Private - No Actions", "index=payments_test level=INFO", {"action.webhook": "0", "action.email": "0"}, "user"),
        ("alice", alice_password, "bulk_test_alice", "ALICE - Private - Empty Webhook URL", "index=payments_test level=ERROR", {"action.webhook": "0", "action.webhook.param.url": "", "action.email": "0"}, "user"),
        ("bob", bob_password, "bulk_test_bob", "BOB - Private - No Actions", "index=security_test level=INFO", {"action.webhook": "0", "action.email": "0"}, "user"),
        ("bob", bob_password, "bulk_test_bob", "BOB - Private - Empty Webhook URL", "index=platform_test level=ERROR", {"action.webhook": "0", "action.webhook.param.url": "", "action.email": "0"}, "user"),
        # Same title, different owner/app contexts: useful for identity and bulk-match tests.
        ("alice", alice_password, "bulk_test_alice", "DUPLICATE - Payment Errors", "index=payments_test level=ERROR", {"action.webhook": "1", "action.webhook.param.url": "https://example.invalid/duplicate/alice", "action.email": "0"}, "global"),
        ("bob", bob_password, "bulk_test_bob", "DUPLICATE - Payment Errors", "index=payments_test level=ERROR", {"action.email": "1", "action.email.to": "bob@example.invalid", "action.webhook": "0"}, "global"),
        ("alice", alice_password, "bulk_test_alice_alt", "DUPLICATE - Payment Errors", "index=payments_test level=ERROR", {"action.webhook": "1", "action.webhook.param.url": "https://example.invalid/duplicate/alice-alt", "action.email": "1", "action.email.to": "alice@example.invalid"}, "global"),
        # No-match / already-migrated cases for replace and idempotency checks.
        ("alice", alice_password, "bulk_test_alice", "NO MATCH - SPL Replacement", "index=security_test impossible_synthetic_field=never-match", {"action.webhook": "0", "action.email": "0"}, "user"),
        ("bob", bob_password, "bulk_test_bob", "ALREADY MIGRATED - Webhook v2", "index=platform_test level=ERROR", {"action.webhook": "1", "action.webhook.param.url": "https://example.invalid/hooks/v2", "action.email": "0"}, "global"),
    ]
    for item in cases:
        saved_search(*item)
    print("seed_users_alerts: done; 2 users, 3 apps, 17 owned saved-search fixtures")
    print("seed_users_alerts: fixtures retain their schedules and action settings but are disabled to prevent delivery during testing")


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        print(f"seed_users_alerts: FAILED: {exc}")
        raise
EOF

