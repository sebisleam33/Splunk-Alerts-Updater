# syntax=docker/dockerfile:1
#
# Self-contained Splunk POC image: index, HEC token, 200 seed logs and scheduled jobs/alerts.
# Everything is defined inline in this file - no other files needed.
#
# Base: public Splunk Enterprise image, downloaded automatically during build.
# Splunk licensing still applies; the Enterprise trial supports scheduled alerts.
# Requires Docker with Linux containers and BuildKit. No extra files are needed to build the image.
#
# Run from the folder containing this Dockerfile - build FIRST, then run:
#
#   docker build -t poc-splunk .
#   docker run -d --name poc-splunk \
#     -e SPLUNK_PASSWORD='ChangeThisAdminPassword123!' \
#     -e ALICE_PASSWORD='ChangeThisAlicePassword123!' \
#     -e BOB_PASSWORD='ChangeThisBobPassword123!' \
#     -p 8000:8000 -p 8088:8088 -p 8089:8089 poc-splunk
#
# "pull access denied for poc-splunk" = the build step was skipped or failed (poc-splunk is a local
# image, it does not exist on Docker Hub). Check with: docker images poc-splunk
#
#   Web: http://localhost:8000  (admin / password supplied at docker run)   Search: index=poc
#   Supply all three passwords at runtime; use local-only demo credentials.
#
#   Export the local development CA on Windows (after the container is running):
#     docker cp poc-splunk:/opt/splunk/etc/auth/poc-ca.crt .\poc-ca.crt
#     certutil -user -addstore Root .\poc-ca.crt
#   The certificate covers localhost and 127.0.0.1. Connect to one of those names,
#   not the container IP/name. This CA is only for this local POC.
#
# How it works:
#   - The official image keeps its default config in /opt/splunk-etc and copies it into the
#     /opt/splunk/etc volume on first start, so the app is placed there.
#   - Seed logs are generated by scripted inputs when splunkd first starts (fresh timestamps,
#     covering the alert conditions). User bootstrap runs from the container entrypoint after
#     Splunk starts, so it receives the runtime passwords.
#   - Supply all passwords at runtime; they are not baked into the image.
#   - Use fresh volumes for the initial setup; existing Splunk configs can override this app.

# Generate TLS material in a separate build stage. The Splunk image's wrapper needs a
# splunk-launch.conf that is created at container startup, so it cannot generate certs during build.
FROM alpine:3.24 AS tls-certs
RUN apk add --no-cache openssl
RUN set -eu; \
    mkdir -p /tls/poc-tls; \
    openssl genrsa -out /tmp/poc-ca.key 4096; \
    openssl req -x509 -new -sha256 -days 3650 \
      -key /tmp/poc-ca.key \
      -out /tls/poc-ca.crt \
      -subj "/CN=Splunk POC Local Development CA" \
      -addext "basicConstraints=critical,CA:TRUE" \
      -addext "keyUsage=critical,keyCertSign,cRLSign"; \
    openssl genrsa -out /tls/poc-tls/localhost.key 2048; \
    openssl req -new -sha256 \
      -key /tls/poc-tls/localhost.key \
      -out /tmp/localhost.csr \
      -subj "/CN=localhost"; \
    printf '%s\n' \
      'basicConstraints=critical,CA:FALSE' \
      'keyUsage=critical,digitalSignature,keyEncipherment' \
      'extendedKeyUsage=serverAuth' \
      'subjectAltName=DNS:localhost,IP:127.0.0.1' \
      > /tmp/localhost.ext; \
    openssl x509 -req -sha256 -days 825 \
      -in /tmp/localhost.csr \
      -CA /tls/poc-ca.crt \
      -CAkey /tmp/poc-ca.key \
      -CAcreateserial \
      -extfile /tmp/localhost.ext \
      -out /tls/poc-tls/localhost.crt; \
    cat /tls/poc-tls/localhost.crt /tls/poc-tls/localhost.key \
      > /tls/poc-tls/localhost.pem; \
    rm -f /tmp/poc-ca.key /tmp/localhost.csr /tmp/localhost.ext \
          /tls/poc-tls/localhost.key

FROM splunk/splunk:latest

ENV SPLUNK_START_ARGS=--accept-license \
    SPLUNK_GENERAL_TERMS=--accept-sgt-current-at-splunk-com

# Local-development CA and localhost server certificate generated in the tls-certs stage.
COPY --from=tls-certs --chown=splunk:splunk /tls/poc-ca.crt /opt/splunk-etc/auth/poc-ca.crt
COPY --from=tls-certs --chown=splunk:splunk /tls/poc-tls/localhost.pem /opt/splunk-etc/auth/poc-tls/localhost.pem

COPY --chown=splunk:splunk <<'EOF' /opt/splunk-etc/system/local/server.conf
[sslConfig]
enableSplunkdSSL = true
serverCert = /opt/splunk/etc/auth/poc-tls/localhost.pem
EOF

