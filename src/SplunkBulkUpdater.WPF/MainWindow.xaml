<Window x:Class="SplunkBulkUpdater.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sections="clr-namespace:SplunkBulkUpdater.WPF.Views.Sections"
        xmlns:controls="clr-namespace:SplunkBulkUpdater.WPF.Controls"
        xmlns:converters="clr-namespace:SplunkBulkUpdater.WPF.Converters"
        Title="Splunk Alert Updater"
        Icon="{StaticResource AppWindowIcon}"
        Width="1180"
        Height="860"
        MinWidth="960"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBrush}"
        Foreground="{DynamicResource TextBrush}"
        Loaded="Window_Loaded">

    <Window.Resources>
        <BooleanToVisibilityConverter
            x:Key="BooleanToVisibilityConverter" />

        <converters:AvailableSectionHeightConverter
            x:Key="AvailableSectionHeightConverter" />
    </Window.Resources>

    <Grid x:Name="PageGrid"
          Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="270" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid x:Name="HeaderRow" Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0"
           Source="{DynamicResource BrandHeaderImage}"
           Width="420"
           Height="40"
           Stretch="Uniform"
           HorizontalAlignment="Left"
           AutomationProperties.Name="Splunk Alert Updater, C# Devs" />

            <controls:ThemeToggleButton Grid.Column="2"
                                VerticalAlignment="Center" />

            <Button Grid.Column="4"
            Content="Log out"
            MinWidth="90"
            Padding="12,7"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Command="{Binding LogoutCommand}" />
        </Grid>

        <!-- Search alerts and Matching alerts -->
        <Grid Grid.Row="1"
              Margin="0,0,0,4">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <sections:SearchSection Grid.Column="0" />
            <sections:MatchesSection Grid.Column="2" />
        </Grid>

        <!-- Change fields -->
        <sections:ReplaceSection Grid.Row="2">
            <sections:ReplaceSection.MaxHeight>
                <MultiBinding
                    Converter="{StaticResource AvailableSectionHeightConverter}"
                    ConverterParameter="270">

                    <Binding ElementName="PageGrid"
                             Path="ActualHeight" />
                    <Binding ElementName="HeaderRow"
                             Path="ActualHeight" />
                    <Binding ElementName="FooterRow"
                             Path="ActualHeight" />
                </MultiBinding>
            </sections:ReplaceSection.MaxHeight>
        </sections:ReplaceSection>

        <!-- Status and review -->
        <Grid x:Name="FooterRow"
              Grid.Row="3"
              MinHeight="40"
              Margin="0,4,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0"
                          Margin="0,0,12,0"
                          MaxHeight="96"
                          VerticalAlignment="Center"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <controls:StatusMessageControl
                    Message="{Binding StatusMessage}"
                    MessageBrush="{Binding StatusBrush}" />
            </ScrollViewer>

            <ProgressBar Grid.Column="1"
                         Width="120"
                         Height="18"
                         Margin="12,0"
                         IsIndeterminate="{Binding IsBusy}"
                         Visibility="{Binding IsBusy,
                             Converter={StaticResource BooleanToVisibilityConverter}}" />

            <Button Grid.Column="2"
                    Content="Review changes"
                    Style="{StaticResource MotionPrimaryButtonStyle}"
                    MinWidth="140"
                    Padding="12,7"
                    Command="{Binding ApplyReplacementCommand}" />
        </Grid>
    </Grid>
</Window>