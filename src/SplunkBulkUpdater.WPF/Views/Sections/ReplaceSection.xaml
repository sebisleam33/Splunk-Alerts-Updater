<UserControl x:Class="SplunkBulkUpdater.WPF.Views.Sections.ReplaceSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <DataTemplate x:Key="ChangeFieldEditorTemplate">
            <Border BorderBrush="#D5DCE5"
                    BorderThickness="0,0,0,1"
                    Padding="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1"
                                Margin="4,0,10,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Key}"
                                   FontSize="10"
                                   Foreground="SlateGray"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <TextBox Grid.Column="2"
                             Margin="0,0,8,0"
                             Padding="6"
                             VerticalContentAlignment="Center"
                             ToolTip="Regex to match in this setting"
                             Text="{Binding MatchRegex, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsSelected,
                                 Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <TextBox Grid.Column="3"
                             Padding="6"
                             VerticalContentAlignment="Center"
                             ToolTip="Replacement value"
                             Text="{Binding ReplacementValue, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsSelected,
                                 Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SplGroupEditorTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding GroupName}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <TextBox Grid.Column="1"
                         Padding="6"
                         Text="{Binding ReplacementValue, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Replacement text for this named SPL group" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <GroupBox 
                  Header="Change fields"
                  Padding="8"
                  Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top"
                            Margin="0,0,0,8">
                    <TextBlock Text="SPL: enter replacement text for each named capture group. For action types, check a setting and enter its match regex and replacement."
                               TextWrapping="Wrap"
                               Foreground="SlateGray" />

                    <ItemsControl Margin="0,6,0,0"
                                  ItemsSource="{Binding SplGroups}"
                                  ItemTemplate="{StaticResource SplGroupEditorTemplate}"
                                  Visibility="{Binding IsSplSelected,
                                      Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="1"
                                   Text="Setting"
                                   FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2"
                                   Text="Regex matching"
                                   FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3"
                                   Text="Replacement"
                                   FontWeight="SemiBold" />
                    </Grid>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding ChangeFields}"
                              ItemTemplate="{StaticResource ChangeFieldEditorTemplate}"
                              Visibility="{Binding IsActionTypeSelected,
                                  Converter={StaticResource BooleanToVisibilityConverter}}" />
            </DockPanel>
        </GroupBox>

    </Grid>
</UserControl>
