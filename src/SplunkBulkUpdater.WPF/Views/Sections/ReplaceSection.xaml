<UserControl x:Class="SplunkBulkUpdater.WPF.Views.Sections.ReplaceSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <!-- Editor row: visible only when the field is checked -->
        <DataTemplate x:Key="ChangeFieldEditorTemplate">
            <Border BorderBrush="#D5DCE5"
                    BorderThickness="0,0,0,1"
                    Padding="6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Margin="4,0,10,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Key}"
                                   FontSize="10"
                                   Foreground="SlateGray"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <TextBox Grid.Column="1"
                             Margin="0,0,8,0"
                             Padding="6"
                             VerticalContentAlignment="Center"
                             ToolTip="Substring or regex to match"
                             Text="{Binding MatchRegex, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBox Grid.Column="2"
                             Padding="6"
                             VerticalContentAlignment="Center"
                             ToolTip="Replacement value"
                             Text="{Binding ReplacementValue, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <GroupBox Header="Change fields"
                  Padding="8"
                  Margin="0,0,0,12">

            <DockPanel>
                <StackPanel DockPanel.Dock="Top"
                            Margin="0,0,0,8">

                    <TextBlock Text="Select the fields to update, then enter the text to match and its replacement."
                               TextWrapping="Wrap"
                               Foreground="SlateGray" />

                    <!-- Dropdown checklist -->
                    <Expander Header="Select fields to update"
                              IsExpanded="False"
                              Margin="0,8,0,0">
                        <Border BorderBrush="#D5DCE5"
                                BorderThickness="1"
                                Padding="6"
                                Margin="0,4,0,0">
                            <ScrollViewer MaxHeight="180"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding ChangeFields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Label}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      ToolTip="{Binding Key}"
                                                      Margin="4,3" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Expander>

                    <!-- Labels for the checked fields' editors -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Field"
                                   FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1"
                                   Text="Text to match"
                                   FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2"
                                   Text="Replacement"
                                   FontWeight="SemiBold" />
                    </Grid>
                </StackPanel>

                <!-- Editors for checked fields -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="True"
                              PanningMode="VerticalOnly">
                    <ItemsControl ItemsSource="{Binding ChangeFields}"
                                  ItemTemplate="{StaticResource ChangeFieldEditorTemplate}" />
                </ScrollViewer>
            </DockPanel>
        </GroupBox>
    </Grid>
</UserControl>