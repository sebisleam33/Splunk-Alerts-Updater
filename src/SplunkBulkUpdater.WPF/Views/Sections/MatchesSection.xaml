<UserControl x:Class="SplunkBulkUpdater.WPF.Views.Sections.MatchesSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SplunkBulkUpdater.WPF.Controls"
             xmlns:converters="clr-namespace:SplunkBulkUpdater.WPF.Converters">

    <UserControl.Resources>
        <converters:MultiRegexHighlightConverter
            x:Key="MultiRegexHighlightConverter" />
    </UserControl.Resources>

    <Grid>
        <GroupBox Header="Matching alerts"
                  Padding="8"
                  Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top"
                            Margin="0,0,0,6">
                    <TextBlock
                        Text="{Binding SelectedMatchCount,
                            StringFormat={}{0} selected}"
                        Foreground="SlateGray" />

                    <TextBlock
                        Text="{Binding DisplayedMatchCount,
                            StringFormat=Showing {0} rows}"
                        Foreground="SlateGray"
                        FontSize="11" />
                </StackPanel>

                <DataGrid
                    x:Name="MatchesGrid"
                    ItemsSource="{Binding DisplayedMatches}"
                    SelectedItem="{Binding SelectedMatch}"
                    AutoGenerateColumns="False"
                    IsReadOnly="False"
                    CanUserAddRows="False"
                    SelectionMode="Single"
                    HeadersVisibility="Column"
                    GridLinesVisibility="Horizontal"
                    EnableRowVirtualization="True"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    ScrollViewer.ScrollChanged="MatchesGrid_ScrollChanged">

                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn
                            Header="Include"
                            Binding="{Binding IsSelected,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"
                            Width="65" />

                        <DataGridTextColumn Header="Name"
                                            Binding="{Binding Id.Name}"
                                            IsReadOnly="True"
                                            Width="2*" />

                        <DataGridTextColumn Header="App"
                                            Binding="{Binding Id.App}"
                                            IsReadOnly="True"
                                            Width="*" />

                        <DataGridTextColumn Header="Owner"
                                            Binding="{Binding Id.Owner}"
                                            IsReadOnly="True"
                                            Width="*" />

                        <DataGridTextColumn
                            Header="Actions"
                            Binding="{Binding AvailableActionsText}"
                            IsReadOnly="True"
                            Width="*" />

                        <DataGridTemplateColumn Header="SPL"
                                                Width="4*"
                                                IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:RegexHighlightTextBlock
                                        SourceText="{Binding SplSearchString}"
                                        TextWrapping="Wrap"
                                        Margin="4,2">

                                        <controls:RegexHighlightTextBlock.HighlightRanges>
                                            <MultiBinding
                                                Converter="{StaticResource MultiRegexHighlightConverter}">
                                                <Binding Path="SplSearchString" />

                                                <Binding
                                                    Path="DataContext.SearchPatterns"
                                                    RelativeSource="{RelativeSource AncestorType={x:Type DataGrid}}" />
                                            </MultiBinding>
                                        </controls:RegexHighlightTextBlock.HighlightRanges>
                                    </controls:RegexHighlightTextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>
    </Grid>
</UserControl>