<UserControl x:Class="SplunkBulkUpdater.WPF.Views.Sections.MatchesSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SplunkBulkUpdater.WPF.Controls"
             xmlns:converters="clr-namespace:SplunkBulkUpdater.WPF.Converters">

    <UserControl.Resources>
        <converters:MultiRegexHighlightConverter
            x:Key="MultiRegexHighlightConverter" />
    </UserControl.Resources>

    <Grid>
        <Border Style="{StaticResource MotionCardStyle}" Margin="0,0,0,12">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="Matching alerts"
                                   Style="{StaticResource SectionTitleStyle}"
                                   VerticalAlignment="Center" />

                        <controls:InfoButton
                            VerticalAlignment="Center"
                            InfoText="Alerts matching the search criteria. Select the alerts you want to include in the review." />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock
                            Text="{Binding SelectedMatchCount, StringFormat={}{0} selected}"
                            Foreground="{DynamicResource AccentBrush}"
                            FontWeight="SemiBold" />

                        <TextBlock
                            Margin="14,0,0,0"
                            Text="{Binding DisplayedMatchCount, StringFormat=Showing {0} rows}"
                            Foreground="{DynamicResource MutedTextBrush}"
                            FontSize="11"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Button DockPanel.Dock="Bottom"
                    Content="Show more"
                    Command="{Binding LoadMoreMatchesCommand}"
                    IsEnabled="{Binding HasMoreMatches}"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0"
                    Padding="16,6" />

                <DataGrid x:Name="MatchesGrid"
                      ItemsSource="{Binding DisplayedMatches}"
                      SelectedItem="{Binding SelectedMatch}"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name"
                                            Binding="{Binding Id.Name}"
                                            IsReadOnly="True"
                                            Width="2*" />

                        <DataGridTextColumn Header="App"
                                            Binding="{Binding Id.App}"
                                            IsReadOnly="True"
                                            Width="*" />

                        <DataGridTextColumn Header="Owner"
                                            Binding="{Binding Id.Owner}"
                                            IsReadOnly="True"
                                            Width="*" />

                        <DataGridTextColumn Header="Actions"
                                            Binding="{Binding AvailableActionsText}"
                                            IsReadOnly="True"
                                            Width="*" />

                        <DataGridTemplateColumn Header="SPL"
                                                Width="4*"
                                                IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:RegexHighlightTextBlock
                                        SourceText="{Binding SplSearchString}"
                                        TextWrapping="Wrap"
                                        Margin="4,2">

                                        <controls:RegexHighlightTextBlock.HighlightRanges>
                                            <MultiBinding
                                                Converter="{StaticResource MultiRegexHighlightConverter}">
                                                <Binding Path="SplSearchString" />
                                                <Binding Path="DataContext.SearchPatterns"
                                                         RelativeSource="{RelativeSource AncestorType={x:Type DataGrid}}" />
                                            </MultiBinding>
                                        </controls:RegexHighlightTextBlock.HighlightRanges>
                                    </controls:RegexHighlightTextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>