<UserControl x:Class="SplunkBulkUpdater.WPF.Views.Sections.SearchSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SplunkBulkUpdater.WPF.Controls">

    <Border Style="{StaticResource MotionCardStyle}"
            Margin="0,0,0,12">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,16">
                    <TextBlock Text="Search alerts"
                               Style="{StaticResource SectionTitleStyle}"
                               VerticalAlignment="Center" />

                    <controls:InfoButton
                        VerticalAlignment="Center"
                        InfoText="Searches are limited to the search app and your saved searches. Only checked alerts are included in the review and update." />
                </StackPanel>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="App"
                                   Style="{StaticResource FieldLabelStyle}" />

                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource ReadOnlyValueStyle}"
                                   Text="search"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Owner"
                                   Style="{StaticResource FieldLabelStyle}" />

                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource ReadOnlyValueStyle}"
                                   Text="{Binding SignedInUsername, StringFormat=Yours ({0})}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   ToolTip="{Binding SignedInUsername}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Change type"
                                   Style="{StaticResource FieldLabelStyle}" />

                        <ComboBox Margin="0,4,0,0"
                                  Padding="4"
                                  ItemsSource="{Binding ChangeTypes}"
                                  SelectedItem="{Binding SelectedChangeType}" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,4">
                    <TextBlock Text="SPL contains (string)"
                               Style="{StaticResource FieldLabelStyle}"
                               VerticalAlignment="Center" />

                    <controls:InfoButton
                        VerticalAlignment="Center"
                        InfoText="Filter saved searches by a regular expression matched against their SPL text." />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding SearchStringFilterInputs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         ToolTip="SPL filter in field=value format"
                                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />

                                <Button Grid.Column="1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource IconActionButton}"
                                        AutomationProperties.Name="Remove SPL regex filter"
                                        Command="{Binding DataContext.RemoveRegexInputCommand,
                                            RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}">
                                    <Button.Content>
                                        <Path Width="14"
                                              Height="14"
                                              Data="M 3,4 L 13,4 M 5,4 L 5,2 L 11,2 L 11,4 M 4,5 L 4.7,14 L 11.3,14 L 12,5 M 7,7 L 7,12 M 9,7 L 9,12"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.6"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Stretch="Uniform" />
                                    </Button.Content>
                                    <Button.ToolTip>
                                        <ToolTip Style="{StaticResource IconActionToolTip}"
                                                 Content="Remove this regex filter" />
                                    </Button.ToolTip>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Style="{StaticResource IconActionButton}"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,16"
                        AutomationProperties.Name="Add SPL regex filter"
                        AutomationProperties.HelpText="Add another SPL regular expression"
                        Command="{Binding AddSearchStringFilterInputCommand}">
                    <Button.Content>
                        <Path Width="11"
                              Height="11"
                              Data="M 6,1 L 6,11 M 1,6 L 11,6"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Stretch="Uniform" />
                    </Button.Content>
                    <Button.ToolTip>
                        <ToolTip Style="{StaticResource IconActionToolTip}"
                                 Content="Add another regex filter" />
                    </Button.ToolTip>
                </Button>

                <Button Content="Find alerts"
                        Style="{StaticResource MotionPrimaryButtonStyle}"
                        MinWidth="130"
                        Padding="12,7"
                        Margin="0,0,0,12"
                        HorizontalAlignment="Stretch"
                        Command="{Binding FindMatchesCommand}" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>