<UserControl x:Class="SplunkBulkUpdater.WPF.Views.Sections.SearchSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Border Padding="16"
                Margin="0,0,0,12"
                BorderBrush="#D5DCE5"
                BorderThickness="1"
                CornerRadius="6">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="App" />

                        <TextBlock Margin="0,4,0,0"
                                   Padding="7"
                                   Background="#F3F5F8"
                                   Text="search" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Owner" />

                        <TextBlock
                            Margin="0,4,0,0"
                            Padding="7"
                            Background="#F3F5F8"
                            TextWrapping="Wrap"
                            Text="{Binding SignedInUsername,
                                StringFormat=Yours ({0})}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Change type" />

                        <ComboBox Margin="0,4,0,0"
                                  ItemsSource="{Binding ChangeTypes}"
                                  SelectedItem="{Binding SelectedChangeType}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="SPL contains (regular expression)"
                                   TextWrapping="Wrap" />

                        <TextBox
                            Margin="0,4,0,0"
                            Padding="7"
                            Text="{Binding SplRegex,
                                UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <Button Content="Find alerts"
                            MinWidth="130"
                            Padding="12,7"
                            Margin="0,0,0,12"
                            HorizontalAlignment="Stretch"
                            Command="{Binding FindMatchesCommand}" />

                    <TextBlock
                        Text="Searches are limited to the search app and your saved searches. Only checked alerts are included in the review and update."
                        Foreground="SlateGray"
                        FontSize="11"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>