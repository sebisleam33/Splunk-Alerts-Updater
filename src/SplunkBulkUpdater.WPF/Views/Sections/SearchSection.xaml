<UserControl x:Class="SplunkBulkUpdater.WPF.Views.Sections.SearchSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SplunkBulkUpdater.WPF.Controls">

    <Grid>
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Search alerts" Style="{StaticResource SectionTitleStyle}"
                                   VerticalAlignment="Center" />
                        <controls:InfoButton VerticalAlignment="Center"
                                             InfoText="Searches are limited to the search app and your saved searches. Only checked alerts are included in the review and update." />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="App" Style="{StaticResource FieldLabelStyle}" />

                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource ReadOnlyValueStyle}"
                                   Text="search" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Owner" Style="{StaticResource FieldLabelStyle}" />

                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource ReadOnlyValueStyle}"
                            TextWrapping="Wrap"
                            Text="{Binding SignedInUsername,
                                StringFormat=Yours ({0})}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Change type" Style="{StaticResource FieldLabelStyle}" />

                        <ComboBox Margin="0,4,0,0"
                                  ItemsSource="{Binding ChangeTypes}"
                                  SelectedItem="{Binding SelectedChangeType}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SPL contains (regex)" Style="{StaticResource FieldLabelStyle}"
                                       VerticalAlignment="Center" />
                            <controls:InfoButton VerticalAlignment="Center"
                                                 InfoText="Filter saved searches by a regular expression matched against their SPL text. Leave this empty to search without the filter." />
                        </StackPanel>

                        <TextBox
                            Margin="0,4,0,0"
                            Padding="7"
                            Text="{Binding SplRegex,
                                UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <Button Content="Find alerts"
                            Style="{StaticResource PrimaryActionButton}"
                            MinWidth="130"
                            Padding="12,7"
                            Margin="0,0,0,12"
                            HorizontalAlignment="Stretch"
                            Command="{Binding FindMatchesCommand}" />

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
