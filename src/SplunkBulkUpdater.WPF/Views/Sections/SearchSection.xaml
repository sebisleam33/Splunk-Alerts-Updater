<UserControl x:Class="SplunkBulkUpdater.WPF.Views.Sections.SearchSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Border Padding="12"
                Margin="0,0,0,12"
                BorderBrush="#D5DCE5"
                BorderThickness="1"
                CornerRadius="6">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}"
                                             Value="True">
                                    <Setter Property="IsEnabled"
                                            Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- Compact filter row -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Margin="0,0,8,0">
                            <TextBlock Text="App" />

                            <TextBlock Text="search"
                                       Margin="0,4,0,0"
                                       Padding="6"
                                       Background="#F3F5F8"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="search" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="0,0,8,0">
                            <TextBlock Text="Owner" />

                            <TextBlock
                                Margin="0,4,0,0"
                                Padding="6"
                                Background="#F3F5F8"
                                TextTrimming="CharacterEllipsis"
                                Text="{Binding SignedInUsername,
                                    StringFormat=Yours ({0})}"
                                ToolTip="{Binding SignedInUsername,
                                    StringFormat=Yours ({0})}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Change type" />

                            <ComboBox
                                Margin="0,4,0,0"
                                Padding="4"
                                ItemsSource="{Binding ChangeTypes}"
                                SelectedItem="{Binding SelectedChangeType}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="SPL regular expressions"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />

                    <TextBlock
                        Text="Find alerts matching any entered expression."
                        Margin="0,4,0,8"
                        Foreground="SlateGray"
                        FontSize="11"
                        TextWrapping="Wrap" />

                    <!-- First expression -->
                    <TextBox
                        Padding="7"
                        Margin="0,0,0,8"
                        ToolTip="First SPL regular expression"
                        Text="{Binding SplRegex,
                            UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Additional expressions -->
                    <ItemsControl ItemsSource="{Binding AdditionalRegexInputs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox
                                        Grid.Column="0"
                                        Padding="7"
                                        ToolTip="Additional SPL regular expression"
                                        Text="{Binding Pattern,
                                            UpdateSourceTrigger=PropertyChanged}" />

                                    <Button
                                        Grid.Column="1"
                                        Content="×"
                                        Width="30"
                                        Margin="6,0,0,0"
                                        FontSize="18"
                                        ToolTip="Remove this expression"
                                        AutomationProperties.Name="Remove expression"
                                        Command="{Binding DataContext.RemoveRegexInputCommand,
                                            RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="+"
                            Width="32"
                            Height="30"
                            FontSize="18"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,12"
                            ToolTip="Add another regular expression"
                            AutomationProperties.Name="Add expression"
                            Command="{Binding AddRegexInputCommand}" />

                    <Button Content="Find alerts"
                            MinWidth="130"
                            Padding="12,7"
                            Margin="0,0,0,12"
                            HorizontalAlignment="Stretch"
                            Command="{Binding FindMatchesCommand}" />

                    <TextBlock
                        Text="Searches are limited to the search app and your saved searches. Only checked alerts are included in the review and update."
                        Foreground="SlateGray"
                        FontSize="11"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>