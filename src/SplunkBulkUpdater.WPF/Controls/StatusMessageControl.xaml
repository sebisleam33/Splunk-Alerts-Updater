<UserControl x:Class="SplunkBulkUpdater.WPF.Controls.StatusMessageControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<UserControl.Style>
		<Style TargetType="UserControl">
			<Style.Triggers>
				<DataTrigger Binding="{Binding Message, ElementName=Root}"
                             Value="">
					<Setter Property="Visibility"
                            Value="Collapsed" />
				</DataTrigger>

				<DataTrigger Binding="{Binding Message, ElementName=Root}"
                             Value="{x:Null}">
					<Setter Property="Visibility"
                            Value="Collapsed" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
	</UserControl.Style>

	<TextBlock x:Name="StatusText"
               Text="{Binding Message, ElementName=Root}"
               TextWrapping="Wrap"
               VerticalAlignment="Center" />
</UserControl>