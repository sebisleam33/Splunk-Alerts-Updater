<UserControl x:Class="SplunkBulkUpdater.WPF.Controls.ThemeToggleButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">

    <Button x:Name="ToggleButton"
            Style="{StaticResource ThemeToggleButtonStyle}"
            Click="OnClick"
            ToolTip="Switch color theme">
        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center">
            <Path x:Name="ThemeIcon"
                  Width="17"
                  Height="17"
                  Stroke="{Binding Foreground, ElementName=ToggleButton}"
                  StrokeThickness="1.8"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  Stretch="Uniform"
                  VerticalAlignment="Center"
                  Data="M 12,2 A 10,10 0 1 0 22,12 A 8,8 0 0 1 12,2 Z" />

            <TextBlock x:Name="ThemeLabel"
                       Text="Dark mode"
                       Margin="9,0,0,0"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Button>
</UserControl>