<Application x:Class="SplunkBulkUpdater.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="OnStartup"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Colors.xaml" />
                <ResourceDictionary Source="Resources/Typography.xaml" />
                <ResourceDictionary Source="Resources/Surfaces.xaml" />
                <ResourceDictionary Source="Resources/Buttons.xaml" />
                <ResourceDictionary Source="Resources/Motion.xaml" />
                <ResourceDictionary Source="Resources/Inputs.xaml" />
                <ResourceDictionary Source="Resources/ScrollBars.xaml" />
                <ResourceDictionary Source="Resources/Tables.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BitmapImage x:Key="AppWindowIcon"
                         UriSource="pack://application:,,,/Assets/AppIcon.ico" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>