<Window x:Class="SplunkBulkUpdater.WPF.Dialogs.AlertActionConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review action changes" Width="1050" Height="650" MinWidth="800" MinHeight="420"
        Icon="{StaticResource AppWindowIcon}"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PageBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Review proposed action updates" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Uncheck any alert you do not want to update." Margin="0,5,0,0"
                       Style="{StaticResource MutedTextStyle}" />
            <TextBlock x:Name="SummaryText"
           Margin="0,5,0,0"
           FontWeight="SemiBold"
           Foreground="{DynamicResource AccentBrush}" />
        </StackPanel>
        <DataGrid x:Name="ReviewGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Apply" Width="65">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Alert" Binding="{Binding Name}" IsReadOnly="True" Width="2*" />
                <DataGridTextColumn Header="App" Binding="{Binding App}" IsReadOnly="True" Width="*" />
                <DataGridTextColumn Header="Owner" Binding="{Binding Owner}" IsReadOnly="True" Width="*" />
                <DataGridTextColumn Header="Current values" Binding="{Binding Current}" IsReadOnly="True" Width="2*" />
                <DataGridTextColumn Header="Proposed values" Binding="{Binding Proposed}" IsReadOnly="True" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="100" Padding="12,7" Margin="0,0,8,0" />
            <Button x:Name="ApplyButton" Content="Apply checked changes" Style="{StaticResource PrimaryActionButton}"
                    IsDefault="True" Click="Apply_Click" MinWidth="160" Padding="12,7" />
        </StackPanel>
    </Grid>
</Window>
