<Window x:Class="SplunkBulkUpdater.WPF.Dialogs.LogoutConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm logout"
        Width="420"
        Height="230"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Log out?"
                   FontSize="22"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center" />

        <TextBlock Grid.Row="1"
                   Margin="0,12,0,20"
                   Text="Your current Splunk session will be cleared. You will need to sign in again."
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedTextBrush}" />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Cancel"
                    MinWidth="90"
                    Padding="12,7"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="Cancel_Click" />

            <Button Content="Log out"
                    Style="{StaticResource PrimaryActionButton}"
                    MinWidth="90"
                    Padding="12,7"
                    IsDefault="True"
                    Click="Confirm_Click" />
        </StackPanel>
    </Grid>
</Window>
