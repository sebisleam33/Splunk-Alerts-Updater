<Window x:Class="SplunkBulkUpdater.WPF.Dialogs.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SplunkBulkUpdater.WPF.Controls"
        Title="Sign in to Splunk"
        Width="420"
        Height="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="72" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Splunk Alert Updater"
                       Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Sign in with your Splunk credentials to continue."
                       Margin="0,6,0,0"
                       Style="{StaticResource MutedTextStyle}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="Username" />
            <TextBox Margin="0,5,0,0"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="Password" />
            <PasswordBox x:Name="PasswordInput"
                         Margin="0,5,0,0"
                         PasswordChanged="PasswordInput_OnPasswordChanged" />
        </StackPanel>

        <Button Grid.Row="3"
                Content="Sign in"
                Style="{StaticResource PrimaryActionButton}"
                Height="36"
                IsDefault="True"
                Command="{Binding SignInCommand}" />

        <ProgressBar Grid.Row="4"
                     Height="16"
                     Margin="0,12,0,0"
                     IsIndeterminate="{Binding IsBusy}"
                     Visibility="{Binding IsBusy,
                         Converter={StaticResource BooleanToVisibilityConverter}}" />

        <ScrollViewer Grid.Row="5"
                      Margin="0,12,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <controls:StatusMessageControl
                Message="{Binding StatusMessage}"
                MessageBrush="{Binding StatusBrush}" />
        </ScrollViewer>
    </Grid>
</Window>