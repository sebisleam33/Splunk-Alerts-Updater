<Window x:Class="SplunkBulkUpdater.WPF.Dialogs.ReplacementConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SplunkBulkUpdater.WPF.Controls"
        Title="Review replacement"
        Width="1200"
        Height="650"
        MinWidth="850"
        MinHeight="450"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBrush}"
        FontFamily="Segoe UI"
        FontSize="13">




    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">

            <TextBlock Text="Review replacement"
                       Style="{StaticResource PageTitleStyle}"/>

            <TextBlock
                Text="Verify the before and after SPL queries before applying changes."
                Margin="0,6,0,0"
                Foreground="{DynamicResource MutedTextBrush}"/>

        </StackPanel>

        <!-- SUMMARY -->
        <Border Grid.Row="1"
                Style="{StaticResource SummaryBorderStyle}"
                Margin="0,0,0,15">

            <TextBlock x:Name="SummaryText"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}"/>

        </Border>

        <!-- LEGEND -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,12">

            <Border Background="{DynamicResource BeforeHighlightBrush}"
                    Padding="8,4"
                    Margin="0,0,15,0"
                    CornerRadius="3">

                <TextBlock Text="Original match"
                           FontWeight="Bold"
                           Foreground="Black"/>
            </Border>

            <Border Background="{DynamicResource AfterHighlightBrush}"
                    Padding="8,4"
                    CornerRadius="3">

                <TextBlock Text="Replacement text"
                           FontWeight="Bold"
                           Foreground="Black"/>
            </Border>

        </StackPanel>

        <!-- PREVIEW GRID -->
        <DataGrid x:Name="PreviewGrid"
                  Style="{StaticResource PreviewDataGridStyle}"
                  Grid.Row="3"
                  Margin="0,0,0,15"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="False"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">

            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Apply" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="65" />

                <DataGridTextColumn Header="Saved search"
                                    Binding="{Binding Name}"
                                    Width="170"/>

                <DataGridTextColumn Header="App"
                                    Binding="{Binding App}"
                                    Width="110"/>

                <DataGridTextColumn Header="Owner"
                                    Binding="{Binding Owner}"
                                    Width="110"/>

                <!-- BEFORE -->
                <DataGridTemplateColumn Header="Before" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>

                            <controls:RegexHighlightTextBlock
                                SourceText="{Binding OriginalSpl}"
                                HighlightRanges="{Binding BeforeRanges}"
                                HighlightBrush="{DynamicResource BeforeHighlightBrush}"
                                HighlightForeground="Black"
                                TextWrapping="Wrap"
                                VerticalAlignment="Top"
                                Margin="4"/>

                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- AFTER -->
                <DataGridTemplateColumn Header="After" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>

                            <controls:RegexHighlightTextBlock
                                SourceText="{Binding UpdatedSpl}"
                                HighlightRanges="{Binding AfterRanges}"
                                HighlightBrush="{DynamicResource AfterHighlightBrush}"
                                HighlightForeground="Black"
                                TextWrapping="Wrap"
                                VerticalAlignment="Top"
                                Margin="4"/>

                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- FOOTER -->
        <Grid Grid.Row="4">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Cancel"
                        Style="{StaticResource DialogActionButton}"
                        IsCancel="True"/>

                <Button Content="Apply Replacement"
                        Style="{StaticResource PrimaryActionButton}"
                        Margin="8,0,0,0"
                        MinWidth="150"
                        IsDefault="True"
                        Click="ApplyReplacement_Click"/>

            </StackPanel>
        </Grid>
    </Grid>
</Window>
