<Window x:Class="SplunkBulkUpdater.WPF.Dialogs.ReplacementConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SplunkBulkUpdater.WPF.Controls"
        Title="Review replacement"
        Width="1200"
        Height="650"
        MinWidth="850"
        MinHeight="450"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        FontSize="13">


	<Window.Resources>

		<Style TargetType="DataGrid">
			<Setter Property="AutoGenerateColumns" Value="False"/>
			<Setter Property="CanUserAddRows" Value="False"/>
			<Setter Property="CanUserDeleteRows" Value="False"/>
			<Setter Property="IsReadOnly" Value="True"/>
			<Setter Property="HeadersVisibility" Value="Column"/>
			<Setter Property="GridLinesVisibility" Value="Horizontal"/>
			<Setter Property="RowBackground" Value="White"/>
			<Setter Property="AlternatingRowBackground" Value="#F1F5F9"/>
			<Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0"/>
			<Setter Property="BorderBrush" Value="#CBD5E1"/>
			<Setter Property="RowHeaderWidth" Value="0"/>
		</Style>

		<Style TargetType="DataGridColumnHeader">
			<Setter Property="Background" Value="#E2E8F0"/>
			<Setter Property="Foreground" Value="#0F172A"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Padding" Value="10,9"/>
		</Style>

		<Style TargetType="DataGridCell">
			<Setter Property="Padding" Value="7"/>
			<Setter Property="VerticalContentAlignment" Value="Top"/>
			<Setter Property="BorderThickness" Value="0"/>
		</Style>

		<Style x:Key="ActionButtonStyle" TargetType="Button">
			<Setter Property="Padding" Value="20,10"/>
			<Setter Property="MinWidth" Value="125"/>
			<Setter Property="Margin" Value="6,0,0,0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
		</Style>

	</Window.Resources>

	<Grid Margin="20">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- HEADER -->
		<StackPanel Grid.Row="0" Margin="0,0,0,15">

			<TextBlock Text="Review replacement"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#0F172A"/>

			<TextBlock
                Text="Verify the before and after SPL queries before applying changes."
                Margin="0,6,0,0"
                Foreground="#64748B"/>

		</StackPanel>

		<!-- SUMMARY -->
		<Border Grid.Row="1"
                Background="#EFF6FF"
                BorderBrush="#BFDBFE"
                BorderThickness="1"
                CornerRadius="5"
                Padding="12"
                Margin="0,0,0,15">

			<TextBlock x:Name="SummaryText"
                       FontWeight="SemiBold"
                       Foreground="#1D4ED8"/>

		</Border>

		<!-- LEGEND -->
		<StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,12">

			<TextBlock Text="Highlight legend:"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="0,0,15,0"/>

			<Border Background="Gold"
                    Padding="8,4"
                    Margin="0,0,15,0"
                    CornerRadius="3">

				<TextBlock Text="Original match"
                           FontWeight="Bold"
                           Foreground="Black"/>
			</Border>

			<Border Background="LimeGreen"
                    Padding="8,4"
                    CornerRadius="3">

				<TextBlock Text="Replacement text"
                           FontWeight="Bold"
                           Foreground="Black"/>
			</Border>

		</StackPanel>

		<!-- PREVIEW GRID -->
		<DataGrid x:Name="PreviewGrid"
                  Grid.Row="3"
                  Margin="0,0,0,15"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="False"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">

			<DataGrid.Columns>

				<DataGridTextColumn Header="Saved search"
                                    Binding="{Binding Name}"
                                    Width="170"/>

				<DataGridTextColumn Header="App"
                                    Binding="{Binding App}"
                                    Width="110"/>

				<DataGridTextColumn Header="Owner"
                                    Binding="{Binding Owner}"
                                    Width="110"/>

				<!-- BEFORE -->
				<DataGridTemplateColumn Header="Before" Width="*">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>

							<controls:RegexHighlightTextBlock
                                SourceText="{Binding OriginalSpl}"
                                HighlightRanges="{Binding BeforeRanges}"
                                HighlightBrush="Gold"
                                HighlightForeground="Black"
                                TextWrapping="Wrap"
                                VerticalAlignment="Top"
                                Margin="4"/>

						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<!-- AFTER -->
				<DataGridTemplateColumn Header="After" Width="*">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>

							<controls:RegexHighlightTextBlock
                                SourceText="{Binding UpdatedSpl}"
                                HighlightRanges="{Binding AfterRanges}"
                                HighlightBrush="LimeGreen"
                                HighlightForeground="Black"
                                TextWrapping="Wrap"
                                VerticalAlignment="Top"
                                Margin="4"/>

						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

			</DataGrid.Columns>
		</DataGrid>

		<!-- FOOTER -->
		<Grid Grid.Row="4">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<TextBlock Grid.Column="0"
                       Text="Changes will only be applied after confirmation."
                       Foreground="#64748B"
                       VerticalAlignment="Center"/>

			<StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

				<Button Content="Cancel"
                        Style="{StaticResource ActionButtonStyle}"
                        IsCancel="True"/>

				<Button Content="Apply Replacement"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#2563EB"
                        Foreground="White"
                        BorderBrush="#1D4ED8"
                        IsDefault="True"
                        Click="ApplyReplacement_Click"/>

			</StackPanel>
		</Grid>
	</Grid>
</Window>
