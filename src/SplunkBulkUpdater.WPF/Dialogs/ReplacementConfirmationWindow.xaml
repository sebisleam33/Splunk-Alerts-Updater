<Window x:Class="SplunkBulkUpdater.WPF.Dialogs.ReplacementConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SplunkBulkUpdater.WPF.Controls"
        Title="Review replacement"
        Icon="{StaticResource AppWindowIcon}"
        Width="1200"
        Height="650"
        MinWidth="850"
        MinHeight="450"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="13">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,15">

            <TextBlock Text="Review replacement"
                       Style="{StaticResource PageTitleStyle}" />

            <TextBlock
                Text="Verify the before and after SPL queries before applying changes."
                Margin="0,6,0,0"
                Foreground="{DynamicResource MutedTextBrush}" />
        </StackPanel>

        <!-- Selection count -->
        <TextBlock x:Name="SummaryText"
                   Grid.Row="1"
                   Margin="0,0,0,14"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource AccentBrush}" />

        <!-- Preview -->
        <DataGrid x:Name="PreviewGrid"
                  Grid.Row="2"
                  Style="{StaticResource PreviewDataGridStyle}"
                  IsReadOnly="False"
                  Margin="0,0,0,15"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="False"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">

            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Apply"
                                        Width="65">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsSelected,
                                          Mode=TwoWay,
                                          UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Saved search"
                                    Binding="{Binding Name}"
                                    IsReadOnly="True"
                                    Width="170" />

                <DataGridTextColumn Header="App"
                                    Binding="{Binding App}"
                                    IsReadOnly="True"
                                    Width="110" />

                <DataGridTextColumn Header="Owner"
                                    Binding="{Binding Owner}"
                                    IsReadOnly="True"
                                    Width="110" />

                <DataGridTemplateColumn Header="Before"
                                        Width="*"
                                        IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <controls:RegexHighlightTextBlock
                                SourceText="{Binding OriginalSpl}"
                                HighlightRanges="{Binding BeforeRanges}"
                                HighlightBrush="{DynamicResource BeforeHighlightBrush}"
                                HighlightForeground="Black"
                                TextWrapping="Wrap"
                                VerticalAlignment="Top"
                                Margin="4" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="After"
                                        Width="*"
                                        IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <controls:RegexHighlightTextBlock
                                SourceText="{Binding UpdatedSpl}"
                                HighlightRanges="{Binding AfterRanges}"
                                HighlightBrush="{DynamicResource AfterHighlightBrush}"
                                HighlightForeground="Black"
                                TextWrapping="Wrap"
                                VerticalAlignment="Top"
                                Margin="4" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Cancel"
                        Style="{StaticResource DialogActionButton}"
                        IsCancel="True" />

                <Button x:Name="ApplyButton"
                        Content="Apply Replacement"
                        Style="{StaticResource PrimaryActionButton}"
                        Margin="8,0,0,0"
                        MinWidth="150"
                        IsDefault="True"
                        Click="ApplyReplacement_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>