<Window x:Class="SplunkBulkUpdater.WPF.Dialogs.ReplacementConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review SPL replacement"
        Width="1150"
        Height="700"
        MinWidth="900"
        MinHeight="500"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Review replacement"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="SummaryText"
                       Margin="0,6,0,0"
                       Foreground="SlateGray" />
            <TextBlock Text="Verify the before and after SPL. The update will apply these displayed changes."
                       Margin="0,4,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <DataGrid x:Name="PreviewGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  EnableRowVirtualization="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Saved search"
                                    Binding="{Binding Id.Name}"
                                    Width="1.5*" />
                <DataGridTextColumn Header="App"
                                    Binding="{Binding Id.App}"
                                    Width="*" />
                <DataGridTextColumn Header="Owner"
                                    Binding="{Binding Id.Owner}"
                                    Width="*" />

                <DataGridTemplateColumn Header="Before" Width="3*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding OriginalSpl}"
                                     IsReadOnly="True"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Padding="6" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="After" Width="3*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding UpdatedSpl}"
                                     IsReadOnly="True"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Padding="6" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Cancel"
                    MinWidth="100"
                    Padding="12,7"
                    Margin="0,0,8,0"
                    IsCancel="True" />
            <Button Content="Apply replacement"
                    MinWidth="150"
                    Padding="12,7"
                    IsDefault="True"
                    Click="ApplyReplacement_Click" />
        </StackPanel>
    </Grid>
</Window>