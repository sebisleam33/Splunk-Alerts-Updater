<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<Resource Include="Assets\BrandHeaderDark.png" />
		<Resource Include="Assets\BrandHeaderLight.png" />
		<Resource Include="Assets\AppIcon.ico" />
	</ItemGroup>
	
	<ItemGroup>
		<ProjectReference Include="..\SplunkBulkUpdater.Application\SplunkBulkUpdater.Application.csproj" />
		<ProjectReference Include="..\SplunkBulkUpdater.Domain\SplunkBulkUpdater.Domain.csproj" />
		<ProjectReference Include="..\SplunkBulkUpdater.Infrastructure\SplunkBulkUpdater.Infrastructure.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
	</ItemGroup>

	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Assets\" />
	</ItemGroup>

</Project>