<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="ScrollPageButtonStyle" TargetType="RepeatButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Handle"
                            Background="{DynamicResource BorderBrush}"
                            CornerRadius="5"
                            Margin="1" />

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Handle"
                                    Property="Background"
                                    Value="{DynamicResource InfoBorderBrush}" />
                        </Trigger>

                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Handle"
                                    Property="Background"
                                    Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="VerticalScrollBarTemplate"
                     TargetType="ScrollBar">
        <Border Background="{DynamicResource GridStripeBrush}"
                CornerRadius="5"
                Padding="1,2">
            <Track x:Name="PART_Track"
                   IsDirectionReversed="True"
                   Orientation="Vertical">
                <Track.DecreaseRepeatButton>
                    <RepeatButton
                        Style="{StaticResource ScrollPageButtonStyle}"
                        Command="{x:Static ScrollBar.PageUpCommand}" />
                </Track.DecreaseRepeatButton>

                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumbStyle}" />
                </Track.Thumb>

                <Track.IncreaseRepeatButton>
                    <RepeatButton
                        Style="{StaticResource ScrollPageButtonStyle}"
                        Command="{x:Static ScrollBar.PageDownCommand}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="HorizontalScrollBarTemplate"
                     TargetType="ScrollBar">
        <Border Background="{DynamicResource GridStripeBrush}"
                CornerRadius="5"
                Padding="2,1">
            <Track x:Name="PART_Track"
                   Orientation="Horizontal">
                <Track.DecreaseRepeatButton>
                    <RepeatButton
                        Style="{StaticResource ScrollPageButtonStyle}"
                        Command="{x:Static ScrollBar.PageLeftCommand}" />
                </Track.DecreaseRepeatButton>

                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumbStyle}" />
                </Track.Thumb>

                <Track.IncreaseRepeatButton>
                    <RepeatButton
                        Style="{StaticResource ScrollPageButtonStyle}"
                        Command="{x:Static ScrollBar.PageRightCommand}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Border>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="11" />
        <Setter Property="Template"
                Value="{StaticResource VerticalScrollBarTemplate}" />

        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="11" />
                <Setter Property="Template"
                        Value="{StaticResource HorizontalScrollBarTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>