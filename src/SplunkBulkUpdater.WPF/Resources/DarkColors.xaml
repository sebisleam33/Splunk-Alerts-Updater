<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <BitmapImage x:Key="BrandHeaderImage"
             UriSource="pack://application:,,,/Assets/BrandHeaderDark.png" />

	<LinearGradientBrush x:Key="PageBrush"
                         StartPoint="0,0"
                         EndPoint="1,1">
		<GradientStop Color="#0A1727" Offset="0" />
		<GradientStop Color="#10263A" Offset="0.54" />
		<GradientStop Color="#0C1A2B" Offset="1" />
	</LinearGradientBrush>

	<SolidColorBrush x:Key="SurfaceBrush" Color="#16283A" />
	<SolidColorBrush x:Key="TextBrush" Color="#EBF4FF" />
	<SolidColorBrush x:Key="MutedTextBrush" Color="#A5B8D1" />
	<SolidColorBrush x:Key="SecondaryTextBrush" Color="#C8DCF3" />
	<SolidColorBrush x:Key="AccentBrush" Color="#63C8EC" />
	<SolidColorBrush x:Key="AccentHoverBrush" Color="#89DCF5" />
	<SolidColorBrush x:Key="BorderBrush" Color="#40536A" />
	<SolidColorBrush x:Key="CardBorderBrush" Color="#2D4056" />
	<SolidColorBrush x:Key="SubtleBlueBrush" Color="#1D4053" />
	<SolidColorBrush x:Key="GridHeaderBrush" Color="#1D3349" />
	<SolidColorBrush x:Key="GridStripeBrush" Color="#1A2C40" />
	<SolidColorBrush x:Key="InfoBorderBrush" Color="#39738A" />
	<SolidColorBrush x:Key="GridLineBrush" Color="#304258" />
	<SolidColorBrush x:Key="GridHeaderTextBrush" Color="#D5E8FB" />

	<SolidColorBrush x:Key="BeforeHighlightBrush" Color="#FFE09B" />
	<SolidColorBrush x:Key="AfterHighlightBrush" Color="#91EDB8" />

	<SolidColorBrush x:Key="ActionTextBrush" Color="#0B1422" />
	<SolidColorBrush x:Key="ToolTipTextBrush" Color="#0B1422" />

	<SolidColorBrush x:Key="StatusSuccessBrush" Color="#77DDAA" />
	<SolidColorBrush x:Key="StatusWarningBrush" Color="#F7C981" />
	<SolidColorBrush x:Key="StatusErrorBrush" Color="#FF9DA5" />
	<SolidColorBrush x:Key="StatusNeutralBrush" Color="#A5B8D1" />

</ResourceDictionary>